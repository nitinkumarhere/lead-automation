{
  "name": "Aviara Labs - High Speed Asynchronous Lead Automation",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "v1/incoming-leads",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [100, 200]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const inputData = $input.item.json.body || $input.item.json;\nconst { name, email, company } = inputData;\n\nif (!name || !email || !company || !email.includes('@')) {\n  throw new Error('Validation Failed: Missing required fields or invalid email structure.');\n}\n\nreturn {\n  json: {\n    name: name,\n    email: email,\n    company: company\n  }\n};"
      },
      "id": "data-validator",
      "name": "Data Validator",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [300, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/api/v1/process-async",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "super-secret-n8n-token"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"name\": \"{{ $json.name }}\",\n  \"email\": \"{{ $json.email }}\",\n  \"company\": \"{{ $json.company }}\"\n}",
        "options": {
          "retryOnFail": true
        }
      },
      "id": "async-pipeline-api",
      "name": "HTTP: Dispatch Async Queue Task",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [500, 200]
    }
  ],
  "connections": {
    "webhook-trigger": {
      "main": [
        [
          {
            "node": "data-validator",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "data-validator": {
      "main": [
        [
          {
            "node": "async-pipeline-api",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
