{
  "name": "Aviara Labs - AI Lead Automation System",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "v1/incoming-leads",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const inputData = $input.item.json.body || $input.item.json;\nconst { name, email, company } = inputData;\n\nif (!name || !email || !company || !email.includes('@')) {\n  throw new Error('Validation Failed: Missing required fields or invalid email structure.');\n}\n\nreturn {\n  json: {\n    name: name,\n    email: email,\n    company: company\n  }\n};"
      },
      "id": "data-validator",
      "name": "Data Validator",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/api/v1/enrich",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "super-secret-n8n-token"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"name\": \"{{ $json.name }}\",\n  \"email\": \"{{ $json.email }}\",\n  \"company\": \"{{ $json.company }}\"\n}",
        "options": {
          "retryOnFail": true
        }
      },
      "id": "enrichment-api",
      "name": "HTTP: Data Enrichment",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/api/v1/classify",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "super-secret-n8n-token"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"message\": \"Lead information processing request.\"\n}",
        "options": {
          "retryOnFail": true
        }
      },
      "id": "classification-api",
      "name": "HTTP: AI Intent Classification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [850, 300]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "YOUR_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Sheet1",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Name": "={{ $json.name }}",
            "Email": "={{ $json.email }}",
            "Company": "={{ $json.company }}"
          }
        },
        "options": {}
      },
      "id": "google-sheets-storage",
      "name": "Save to Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.3,
      "position": [1050, 300]
    }
  ],
  "connections": {
    "webhook-trigger": {
      "main": [
        [
          {
            "node": "data-validator",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "data-validator": {
      "main": [
        [
          {
            "node": "enrichment-api",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "enrichment-api": {
      "main": [
        [
          {
            "node": "classification-api",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "classification-api": {
      "main": [
        [
          {
            "node": "google-sheets-storage",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
